+
+@pytest.mark.parametrize("bottom", MERGED_MODES)
+@pytest.mark.parametrize("ext", ["stl", "3mf", "obj"])
+def test_cli_bottom_merged_produces_a_valid_file_in_all_formats(monkeypatch, tmp_path, capsys, bottom, ext):
