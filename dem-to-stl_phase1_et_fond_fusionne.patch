+    tris, elev, quad_ok, xs, ys, min_e, _ = build(mask, vexag=vexag, seed=seed, bottom=bottom, bottom_max_cells=cap)
+    assert_solid(tris, elev, quad_ok, xs, ys, min_e, vexag=vexag)
